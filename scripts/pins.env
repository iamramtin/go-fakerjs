# Pinned tool versions, sourced by the scripts after they cd to the repository root.
# The Faker.js version has one source of truth, tools.versions; it is read from there, never repeated here.
FAKER_VERSION=$(sed -n 's/^faker  *@faker-js\/faker \([0-9][0-9.]*\) .*/\1/p' tools.versions)
[ -n "$FAKER_VERSION" ] || { echo "pins.env: no faker line in tools.versions" >&2; exit 1; }
QUICKJS_NG_TAG=v0.17.0
QUICKJS_NG_SHA=6d46d07d04041b40f4f49eaa7fdebe44c314c699
WASI_SDK_VERSION=34
BINARYEN_VERSION=132
WIZER_VERSION=11.0.3
WASM2GO_VERSION=v0.4.12
ESBUILD_VERSION=0.25.10
